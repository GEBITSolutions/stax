{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/GEBITSolutions/stax/main/schema/deploy-config.schema.json",
  "title": "stax deploy config",
  "description": "Deploy configuration read by a-wf-setup-ci. Stacks are deployed in dependency levels.",
  "type": "object",
  "properties": {
    "deployment": {
      "description": "Deployment context from this selected YAML. Missing values come directly from GitHub variables; sibling configs are not loaded.",
      "$ref": "#/$defs/deployment"
    },
    "externalRepos": {
      "description": "Repositories providing stack sources or config files, by alias. Stacks reference an alias with source_repo. An empty list means none.",
      "type": ["object", "array"],
      "maxItems": 0,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/externalRepo" }
      }
    },
    "globals": {
      "description": "Values readable by every stack in this file as global.config.var.<key>.",
      "type": "object"
    },
    "stacks": {
      "description": "Stacks deployed by this config.",
      "type": "array",
      "items": { "$ref": "#/$defs/stack" }
    }
  },
  "$defs": {
    "deploymentValue": { "type": ["string", "null"], "pattern": "^[^\\r\\n]*$" },
    "deployment": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "project": { "description": "Project name; falls back to GitHub PROJECT.", "$ref": "#/$defs/deploymentValue" },
        "customer_id": { "description": "Customer identifier; falls back to CUSTOMER_ID.", "$ref": "#/$defs/deploymentValue" },
        "stage": { "description": "Deployment stage; falls back to STAGE.", "$ref": "#/$defs/deploymentValue" },
        "cloud": { "description": "Azure or AWS, case-insensitive; falls back to CLOUD.", "type": ["string", "null"], "pattern": "^(?:[aA][zZ][uU][rR][eE]|[aA][wW][sS]|[^\\S\\r\\n]*)$" },
        "default_location": { "description": "Cloud region; falls back to DEFAULT_LOCATION.", "$ref": "#/$defs/deploymentValue" },
        "resource_group_name": { "description": "Azure resource group; falls back to RESOURCE_GROUP_NAME.", "$ref": "#/$defs/deploymentValue" },
        "public_cloud_flag": { "description": "Public-cloud flag; falls back to PUBLIC_CLOUD_FLAG. An explicit false overrides GitHub.", "type": ["boolean", "string", "null"], "pattern": "^(?:true|false|[^\\S\\r\\n]*)$" },
        "dns_zone_name": { "description": "DNS zone; falls back to DNS_ZONE_NAME.", "$ref": "#/$defs/deploymentValue" },
        "dns_zone_resource_group_name": { "description": "Azure DNS resource group; falls back to DNS_ZONE_RESOURCE_GROUP_NAME.", "$ref": "#/$defs/deploymentValue" },
        "state_storage_account_name": { "description": "Azure state account; falls back to STATE_STORAGE_ACCOUNT_NAME.", "$ref": "#/$defs/deploymentValue" },
        "state_container_name": { "description": "Azure state container; falls back to STATE_CONTAINER_NAME.", "$ref": "#/$defs/deploymentValue" },
        "state_resource_group_name": { "description": "Azure state resource group; falls back to STATE_RESOURCE_GROUP_NAME.", "$ref": "#/$defs/deploymentValue" },
        "state_bucket_name": { "description": "AWS state bucket; falls back to STATE_BUCKET_NAME.", "$ref": "#/$defs/deploymentValue" },
        "state_region": { "description": "AWS state region; falls back to STATE_REGION.", "$ref": "#/$defs/deploymentValue" }
      }
    },
    "externalRepo": {
      "type": "object",
      "properties": {
        "repoURL": { "description": "Git URL, e.g. github.com/<org>/<repo>.git.", "type": "string", "minLength": 1 },
        "targetRevision": { "description": "Default branch, tag or commit.", "type": "string", "minLength": 1 },
        "token": { "description": "Name of the GitHub secret holding a read token.", "type": "string", "minLength": 1 },
        "use_app_token": { "description": "Use the GitHub App token; only works for repositories in the caller's org.", "type": "boolean" }
      },
      "required": ["repoURL", "targetRevision"]
    },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "relativePath": { "type": "string", "minLength": 1 },
    "stack": {
      "type": "object",
      "properties": {
        "id": { "description": "Unique stack id; other stacks reference it in depends_on and stack.<id>.var.<key> inputs.", "type": "string", "minLength": 1 },
        "name": { "description": "Display name.", "type": "string" },
        "type": {
          "description": "Executor that deploys the stack.",
          "enum": [
            "terraform",
            "opentofu",
            "packer",
            "docker-build-push",
            "function-build-deploy",
            "rpmbuild",
            "swa-site-deploy",
            "swa-docs-site-deploy",
            "s3-site-deploy",
            "script",
            "bizep",
            "github-pages-site-deploy"
          ]
        },
        "if": { "description": "Deploy only when this JavaScript condition holds; {stage} and other pipeline values are substituted first.", "type": "string", "examples": ["'{stage}' == 'prod'"], "x-stax-types": "all" },
        "depends_on": { "description": "Stack ids deployed before this one.", "$ref": "#/$defs/stringList", "examples": [[]], "x-stax-types": "all" },
        "stack-groups": { "description": "Groups for selecting stacks in the deploy form.", "$ref": "#/$defs/stringList", "examples": [["core"]], "x-stax-types": "all" },
        "runs-on": { "description": "Runner label.", "type": "string", "examples": ["ubuntu-24.04"], "x-stax-types": "all" },
        "input": {
          "description": "Inputs: reference strings (global.pipeline.var.<key>, stack.<id>.var.<key>, ...) or key/value maps.",
          "type": "array",
          "items": { "type": ["string", "object"] },
          "examples": [["global.pipeline.var.stage"]],
          "x-stax-types": ["terraform", "opentofu", "packer", "docker-build-push", "function-build-deploy", "swa-site-deploy", "swa-docs-site-deploy", "s3-site-deploy", "script", "bizep"]
        },
        "tf-vars": { "type": "object", "additionalProperties": { "type": "string" } },
        "output-var": { "description": "Outputs exported as variables.", "$ref": "#/$defs/stringList", "examples": [["resource_group_name"]], "x-stax-types": ["terraform", "opentofu", "packer"] },
        "output-secret": { "description": "Outputs exported as secrets.", "$ref": "#/$defs/stringList", "examples": [["admin_password"]], "x-stax-types": ["terraform", "opentofu"] },
        "globals": { "description": "Extra values for input resolution.", "type": "object", "examples": [{ "site_name": "docs" }], "x-stax-types": ["swa-site-deploy", "swa-docs-site-deploy", "s3-site-deploy", "script", "bizep"] },
        "location": { "description": "Cloud region.", "type": "string", "examples": ["westeurope"], "x-stax-types": ["terraform", "opentofu", "function-build-deploy", "s3-site-deploy"] },
        "source_repo": {
          "description": "externalRepos alias holding the stack source.",
          "type": "string",
          "examples": ["shared"],
          "x-stax-types": ["terraform", "opentofu", "packer", "swa-site-deploy", "swa-docs-site-deploy", "s3-site-deploy", "script", "bizep", "github-pages-site-deploy"]
        },
        "source_version": {
          "description": "Branch, tag or commit; overrides the alias targetRevision.",
          "type": "string",
          "examples": ["main"],
          "x-stax-types": ["terraform", "opentofu", "packer", "swa-site-deploy", "swa-docs-site-deploy", "s3-site-deploy", "script", "bizep", "github-pages-site-deploy"]
        },
        "destroy": { "description": "Destroy the stack instead of deploying it.", "type": ["boolean", "string"], "examples": [false], "x-stax-types": ["terraform", "opentofu", "swa-site-deploy", "swa-docs-site-deploy"] },

        "folder": {
          "description": "Stack directory: below stack_base_path for terraform/opentofu, below functions/ for function-build-deploy.",
          "$ref": "#/$defs/relativePath",
          "examples": ["network"],
          "x-stax-types": ["terraform", "opentofu", "function-build-deploy"]
        },
        "stack_base_path": { "description": "Defaults to terraform/stacks.", "type": "string", "examples": ["terraform/stacks"], "x-stax-types": ["terraform", "opentofu"] },
        "cloud": { "description": "Defaults to the pipeline cloud, then azure.", "enum": ["azure", "aws"], "examples": ["azure"], "x-stax-types": ["terraform", "opentofu"] },
        "terraform_version": { "type": "string", "examples": ["1.9.8"], "x-stax-types": ["terraform"] },
        "opentofu_version": { "type": "string", "examples": ["1.8.1"], "x-stax-types": ["opentofu"] },
        "local_backend": { "description": "Use local state instead of the remote backend.", "type": "boolean", "examples": [false], "x-stax-types": ["terraform", "opentofu"] },
        "local_terraform_state": { "description": "Alias of local_backend.", "type": "boolean" },
        "upload_plan_artifact": { "type": "boolean", "examples": [false], "x-stax-types": ["terraform", "opentofu"] },
        "checkov_skip_checks": { "$ref": "#/$defs/stringList", "examples": [["CKV_AZURE_35"]], "x-stax-types": ["terraform", "opentofu"] },

        "packer_directory": { "description": "Packer project path, relative to the source repository.", "$ref": "#/$defs/relativePath", "examples": ["packer/ubuntu"], "x-stax-types": ["packer"] },
        "packer_template": { "description": "Template file or directory relative to packer_directory; defaults to '.'.", "$ref": "#/$defs/relativePath", "examples": ["azure.pkr.hcl"], "x-stax-types": ["packer"] },
        "packer_version": { "description": "Exact Packer version.", "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "examples": ["1.11.2"], "x-stax-types": ["packer"] },

        "image_name": { "type": "string", "examples": ["my-app"], "x-stax-types": ["docker-build-push"] },
        "dockerfile_folder": { "description": "Build context containing the Dockerfile.", "type": "string", "examples": ["docker/my-app"], "x-stax-types": ["docker-build-push"] },
        "no_cache": { "type": "boolean", "examples": [false], "x-stax-types": ["docker-build-push"] },
        "registry": { "type": "string", "examples": ["ghcr.io"], "x-stax-types": ["docker-build-push"] },
        "registy": { "description": "Deprecated misspelling of registry; still read and wins over registry.", "type": "string" },
        "input-gh-secrets": { "description": "Build secrets: secret id to GitHub secret name.", "type": "object", "additionalProperties": { "type": "string" }, "examples": [{ "npm_token": "NPM_TOKEN" }], "x-stax-types": ["docker-build-push"] },
        "output-gh-vars": { "type": "object", "additionalProperties": { "type": "string" }, "examples": [{ "image": "IMAGE_REF" }], "x-stax-types": ["docker-build-push"] },

        "runtime": { "enum": ["python", "node"], "examples": ["python"], "x-stax-types": ["function-build-deploy"] },
        "version": { "description": "Runtime version for function-build-deploy.", "type": "string", "examples": ["3.12"], "x-stax-types": ["function-build-deploy"] },

        "rpm_repo_baseurl": { "type": "string", "examples": ["https://rpm.example.com/repo"], "x-stax-types": ["rpmbuild"] },
        "pulp_rpm_repository": { "type": "string", "examples": ["my-repo"], "x-stax-types": ["rpmbuild"] },
        "rpm_gpg_name": { "type": "string", "examples": ["Release Signing Key"], "x-stax-types": ["rpmbuild"] },

        "swa_source_type": { "description": "Static site source; defaults to mkdocs.", "type": "string", "examples": ["mkdocs"], "x-stax-types": ["swa-site-deploy", "swa-docs-site-deploy"] },
        "site_source_type": { "description": "Static site source; defaults to mkdocs.", "enum": ["mkdocs", "zensical", "prebuilt"], "examples": ["mkdocs"], "x-stax-types": ["s3-site-deploy", "github-pages-site-deploy"] },
        "site_url": { "description": "Public site URL.", "type": "string", "pattern": "^https?://", "examples": ["https://docs.example.com/"], "x-stax-types": ["github-pages-site-deploy"] },
        "docs_path": { "description": "Docs directory; defaults to docs.", "$ref": "#/$defs/relativePath", "examples": ["docs"], "x-stax-types": ["swa-site-deploy", "swa-docs-site-deploy", "s3-site-deploy", "github-pages-site-deploy"] },
        "site_source": { "description": "Alias of docs_path.", "type": "string" },
        "app_location": { "description": "Site root containing the site config.", "type": "string", "examples": ["."], "x-stax-types": ["swa-site-deploy", "swa-docs-site-deploy", "s3-site-deploy", "github-pages-site-deploy"] },
        "config_file": { "description": "staticwebapp.config.json path in the source repository.", "type": "string", "examples": ["staticwebapp.config.json"], "x-stax-types": ["swa-site-deploy", "swa-docs-site-deploy"] },
        "config_file_location": { "description": "Directory holding staticwebapp.config.json.", "type": "string", "examples": ["site"], "x-stax-types": ["swa-site-deploy", "swa-docs-site-deploy"] },

        "script": { "description": "Script path relative to the source checkout.", "type": "string", "minLength": 1, "examples": ["scripts/deploy.sh"], "x-stax-types": ["script"] },
        "resource_prefix": { "type": "string", "examples": ["app"], "x-stax-types": ["script", "bizep"] },
        "template": { "description": "Bicep template path for bizep stacks.", "type": "string", "minLength": 1, "examples": ["bicep/main.bicep"], "x-stax-types": ["bizep"] }
      },
      "required": ["id", "type"],
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["terraform", "opentofu", "function-build-deploy"] } }, "required": ["type"] },
          "then": { "required": ["folder"] }
        },
        {
          "if": { "properties": { "type": { "const": "packer" } }, "required": ["type"] },
          "then": { "required": ["packer_directory", "packer_version"] }
        },
        {
          "if": { "properties": { "type": { "const": "s3-site-deploy" } }, "required": ["type"] },
          "then": { "required": ["location"] }
        },
        {
          "if": { "properties": { "type": { "const": "script" } }, "required": ["type"] },
          "then": { "required": ["script"] }
        },
        {
          "if": { "properties": { "type": { "const": "bizep" } }, "required": ["type"] },
          "then": { "required": ["template"] }
        },
        {
          "if": { "properties": { "type": { "const": "function-build-deploy" } }, "required": ["type"] },
          "then": { "required": ["runtime"] }
        }
      ]
    }
  }
}
