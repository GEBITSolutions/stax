{
  "name": "@gebit/stax-cli",
  "version": "0.0.0-development",
  "description": "Scaffold, extend and validate projects for the stax stack framework",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GEBITSolutions/stax.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/GEBITSolutions/stax/tree/main/cli#readme",
  "bugs": "https://github.com/GEBITSolutions/stax/issues",
  "keywords": [
    "cli",
    "github-actions",
    "deployment",
    "opentofu",
    "terraform"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "stax": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync-schema": "node -e \"require('node:fs').cpSync('../schema', 'schema', { recursive: true })\"",
    "prebuild": "npm run sync-schema",
    "pretest": "npm run sync-schema"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
