# Relay between the release-notes agent and the model endpoint (nginx
# template; the official image substitutes the ${...} variables from its
# environment at startup). The agent container sits on an internal Docker
# network and only reaches this relay. The relay forwards the endpoint's
# OpenAI-compatible route over verified TLS and replaces whatever
# Authorization header the agent sends with the real key, so the agent only
# ever holds a dummy key.
server {
    listen 8080;

    location ${LLM_PATH}/v1/ {
        proxy_pass https://${LLM_HOST};
        proxy_ssl_server_name on;
        proxy_ssl_name ${LLM_HOST};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        # nginx verifies only one level by default; endpoints commonly serve
        # an intermediate certificate.
        proxy_ssl_verify_depth 3;
        proxy_set_header Host ${LLM_HOST};
        proxy_set_header Authorization "Bearer ${LLM_API_KEY}";
        proxy_set_header api-key "";
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 300s;
        client_max_body_size 20m;
    }

    location / {
        return 403;
    }
}
