{
  "name": "get-next-version",
  "description": "GitHub Action that calculates the next semantic version based on conventional commits",
  "version": "0.0.0",
  "author": "stax",
  "type": "module",
  "private": true,
  "keywords": [
    "actions",
    "versioning",
    "semantic-release"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "npm": ">=11.0.0 <12.0.0",
    "node": ">=24.0.0 <25.0.0"
  },
  "volta": {
    "node": "24.22.0",
    "npm": "11.21.1"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package": "npx rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/eslintrc": "^3.2.0",
    "@jest/globals": "^30.2.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.6.2",
    "@types/semver": "^7.7.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.32.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "prettier-eslint": "^16.4.2",
    "rollup": "^4.52.3",
    "ts-jest": "^29.4.4",
    "ts-jest-resolver": "^2.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "*"
  },
  "overrides": {
    "undici": "^7.29.1",
    "prettier-eslint": {
      "minimatch": ">=9.0.7"
    },
    "@eslint/eslintrc": {
      "minimatch": "^3.1.5"
    }
  }
}
